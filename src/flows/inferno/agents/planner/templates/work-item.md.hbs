## Execution Manifest

context:
  required:
{{#each context.required}}
    - path: {{this.path}}
      reason: {{this.reason}}
{{/each}}
  patterns:
{{#each context.patterns}}
    - path: {{this.path}}
      reason: {{this.reason}}
{{/each}}
  tests:
{{#each context.tests}}
    - path: {{this.path}}
      reason: {{this.reason}}
{{/each}}
ownership:
  editable:
{{#each ownership.editable}}
    - {{this}}
{{/each}}
{{#if reads}}
reads:
{{#each reads}}
    - path: {{this.path}}
      source: {{this.source}}
      when: {{this.when}}
      stale: {{this.stale}}
{{/each}}
{{/if}}
{{!-- writes: the functions the change writes through; run.cjs frontier prints every caller file the item does not cite as a candidate line --}}
{{#if writes}}
writes:
{{#each writes}}
    - {{this}}
{{/each}}
{{/if}}
{{#if provides}}
provides:
{{#each provides}}
    - kind: {{this.kind}}
      name: {{this.name}}
{{/each}}
{{/if}}
{{#if consumes}}
consumes:
{{#each consumes}}
    - kind: {{this.kind}}
      name: {{this.name}}
{{#if this.seam}}
      seam: {{this.seam}}
{{/if}}
{{/each}}
{{/if}}
{{#if probes}}
probes:
{{#each probes}}
    - run: {{this.run}}
      shows: {{this.shows}}
{{/each}}
{{/if}}
{{#if diagnosis}}
diagnosis:
  claim: {{diagnosis.claim}}
  probe: {{diagnosis.probe}}
  shows: {{diagnosis.shows}}
{{/if}}
{{#if design_contract}}
design_contract:
{{#each design_contract}}
    - path: {{this.path}}
      reason: {{this.reason}}
{{/each}}
{{/if}}
{{#if finalize_check}}
finalize_check: {{finalize_check}}
{{/if}}

